{
  "name": "@happy-llm-journey/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "npm run content",
    "dev": "vite --host 127.0.0.1",
    "precheck": "npm run content",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
